{
	"name": "omnitrix",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w @omnitrix/desktop",
		"test": "vitest run",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@types/node": "^22.20.5",
		"electron": "^45.4.1",
		"koffi": "^3.3.8",
		"playwright-core": "^1.65.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
